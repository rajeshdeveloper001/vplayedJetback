<resources>
    <!--
        User-facing text lives in the shared string catalog (../kmp, shared/src/commonMain/composeResources;
        `com.vplayed.shared.l10n.Res`), the same strings VPlayed shows, with their translations.
        Only text that is never translated stays here. app_name is generated per build type in
        app/build.gradle.kts (resValue).
    -->

    <!-- Brand name: fills %1$s in shared messages that name it. -->
    <string name="brand_name" translatable="false">VPlayed</string>

    <!-- Splash screen -->
    <string name="splash_logo_description" translatable="false">Vplayed</string>

    <!-- Login -->
    <string name="login_platform_android_tv" translatable="false">Android TV</string>
    <string name="login_platform_apple_tv" translatable="false">Apple TV</string>
    <string name="login_platform_samsung" translatable="false">Samsung Smart TV</string>
    <string name="login_platform_fire_tv" translatable="false">Fire TV Stick</string>
    <string name="login_platform_lg" translatable="false">LG webOS</string>

    <!-- Design system -->
    <string name="font_inter" translatable="false">Inter</string>
</resources>
